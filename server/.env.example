# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Razorpay keys - get these from https://dashboard.razorpay.com/app/keys
# NEVER commit real keys or expose the key secret to the frontend
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Server
PORT=5000
NODE_ENV=development

# Comma separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173
